# Normalize line endings to LF in the repo; Git handles CRLF checkout on Windows
* text=auto eol=lf
*.ts  text eol=lf
*.tsx text eol=lf
*.js  text eol=lf
*.json text eol=lf
*.md  text eol=lf
*.prisma text eol=lf
*.css text eol=lf

# Binaries — no line ending conversion
*.png  binary
*.jpg  binary
*.ico  binary
*.woff binary
*.woff2 binary
