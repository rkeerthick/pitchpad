# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string.
# Free hosted options: Supabase (supabase.com), Neon (neon.tech), Railway (railway.app)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL="postgresql://postgres:password@localhost:5432/pitchpad"

# ── Clerk ─────────────────────────────────────────────────────────────────────
# Create an app at https://dashboard.clerk.com
# Keys are in: Dashboard → API Keys

# Server-side key (never expose to client)
CLERK_SECRET_KEY="sk_test_..."

# Client-side publishable key (safe to expose — goes in NEXT_PUBLIC_*)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."

# Webhook signing secret:
#   Dashboard → Webhooks → Add endpoint
#   URL: https://your-domain.com/api/webhooks/clerk
#   Events to subscribe: user.created, user.updated
CLERK_WEBHOOK_SECRET="whsec_..."

# Clerk route URLs (these tell Clerk where your auth pages live)
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"

# After auth, Clerk redirects here (then / redirects to the workspace)
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/"
NEXT_PUBLIC_CLERK_AFTER_SIGN_OUT_URL="/sign-in"

# ── App URL ───────────────────────────────────────────────────────────────────
# Used to build absolute invite URLs. No trailing slash.
NEXT_PUBLIC_APP_URL="http://localhost:4000"

# ── Gemini AI ─────────────────────────────────────────────────────────────────
# Get your key at https://aistudio.google.com/apikey
# Key format: AIza...
GEMINI_API_KEY="AIza..."

# ── Email (optional) ─────────────────────────────────────────────────────────
# If not set, invite URLs are logged to the console instead of emailed.
# Create an account at https://resend.com and verify your sending domain.
# RESEND_API_KEY="re_..."
# RESEND_FROM_DOMAIN="yourdomain.com"
